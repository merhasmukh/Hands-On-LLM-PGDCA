87534-3cc3-4a6f-bb4f-2453118ea37a"], "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/student_faq.txt", "file_name": "student_faq.txt", "file_type": "text/plain", "file_size": 245, "creation_date": "2026-09-28", "last_modified_date": "2026-09-28"}}, "4dff4dce-b0ca-494e-864a-0455865670d4": {"node_ids": ["63df827c-d53c-4d11-a8b5-df66710e294e"], "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/syllabus_pgdca.txt", "file_name": "syllabus_pgdca.txt", "file_type": "text/plain", "file_size": 418, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}}}, "docstore/data": {"a054f934-9305-482c-bc47-cc93d1d76a61": {"__data__": {"id_": "a054f934-9305-482c-bc47-cc93d1d76a61", "embedding": null, "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/langchain_info.txt", "file_name": "langchain_info.txt", "file_type": "text/plain", "file_size": 256, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "27c3e471-520d-47ef-b0cb-b2c65e530ca6", "node_type": "4", "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/langchain_info.txt", "file_name": "langchain_info.txt", "file_type": "text/plain", "file_size": 256, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}, "hash": "1e7f3cb810e19ff3f3e3bf996c30ba3d20b6dd7e139152877ae3cc769fce9375", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "LangChain is a framework for developing applications powered by language models.\nIt provides standard, extendable interfaces for Prompts, LLMs, Memory, and Agents.\nLCEL (LangChain Expression Language) is a declarative way to easily compose chains together.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 256, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "4883e86c-0876-4c62-8596-0204d5464678": {"__data__": {"id_": "4883e86c-0876-4c62-8596-0204d5464678", "embedding": null, "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/llamaindex_info.txt", "file_name": "llamaindex_info.txt", "file_type": "text/plain", "file_size": 242, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "98a76533-f9a3-490f-9a71-a8549c5a07a3", "node_type": "4", "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/llamaindex_info.txt", "file_name": "llamaindex_info.txt", "file_type": "text/plain", "file_size": 242, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}, "hash": "5ec30849529887e2f34f344042327baa580bfdc7895dc958ab712a8aa470b277", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "LlamaIndex is a data framework for LLM applications to connect private datasets.\nIt enables loading data via SimpleDirectoryReader, parsing documents into Nodes, indexing them inside a VectorStoreIndex, and querying them using a Query Engine.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 242, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "3cd87534-3cc3-4a6f-bb4f-2453118ea37a": {"__data__": {"id_": "3cd87534-3cc3-4a6f-bb4f-2453118ea37a", "embedding": null, "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/student_faq.txt", "file_name": "student_faq.txt", "file_type": "text/plain", "file_size": 245, "creation_date": "2026-09-28", "last_modified_date": "2026-09-28"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "92c238f6-bdc5-4331-9376-a5f53b72c376", "node_type": "4", "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/student_faq.txt", "file_name": "student_faq.txt", "file_type": "text/plain", "file_size": 245, "creation_date": "2026-09-28", "last_modified_date": "2026-09-28"}, "hash": "d3263207a4e73d953769e6cd086f264cb995cbe3eb8b7c048d77daca442497dd", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "FAQ 1: The PGDCA practical examination carries 40 marks and theory carries 60 marks.\nFAQ 2: Students must submit all unit lab notebooks before the final practical check.\nFAQ 3: The minimum passing grade for each unit practical evaluation is 50%.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 245, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "63df827c-d53c-4d11-a8b5-df66710e294e": {"__data__": {"id_": "63df827c-d53c-4d11-a8b5-df66710e294e", "embedding": null, "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/syllabus_pgdca.txt", "file_name": "syllabus_pgdca.txt", "file_type": "text/plain", "file_size": 418, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "4dff4dce-b0ca-494e-864a-0455865670d4", "node_type": "4", "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/syllabus_pgdca.txt", "file_name": "syllabus_pgdca.txt", "file_type": "text/plain", "file_size": 418, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}, "hash": "7693d5b6fc5dbebdddda76aa572b9161d71bc56dbcaa828bd31c1280435a0caf", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "PGDCA Course Structure and Units:\nUnit 1 covers Python ecosystem, environments, variables, data structures, and APIs.\nUnit 2 covers Advanced APIs, parameter tunings, concurrency, rate limits, and cost calculation models.\nUnit 3 covers LLM Frameworks, LangChain chains, memories, LlamaIndex documents search, and vector stores.\nUnit 4 covers local LLM runtimes, Ollama, model quantizations, and deploying final systems.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 418, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}}