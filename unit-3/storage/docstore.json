ffae4-9d72-4843-82c8-75270649a165"], "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/student_faq.txt", "file_name": "student_faq.txt", "file_type": "text/plain", "file_size": 245, "creation_date": "2026-09-28", "last_modified_date": "2026-09-28"}}, "7df538d7-e383-467f-ba49-ed65e02642e5": {"node_ids": ["efef55cb-069b-42b7-bb89-4f1276c81993"], "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/syllabus_pgdca.txt", "file_name": "syllabus_pgdca.txt", "file_type": "text/plain", "file_size": 418, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}}}, "docstore/data": {"690386fd-f687-492c-8220-092526370536": {"__data__": {"id_": "690386fd-f687-492c-8220-092526370536", "embedding": null, "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/langchain_info.txt", "file_name": "langchain_info.txt", "file_type": "text/plain", "file_size": 256, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "3b19b07b-b357-49f4-8ec2-dd26c8c03dd2", "node_type": "4", "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/langchain_info.txt", "file_name": "langchain_info.txt", "file_type": "text/plain", "file_size": 256, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}, "hash": "1e7f3cb810e19ff3f3e3bf996c30ba3d20b6dd7e139152877ae3cc769fce9375", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "LangChain is a framework for developing applications powered by language models.\nIt provides standard, extendable interfaces for Prompts, LLMs, Memory, and Agents.\nLCEL (LangChain Expression Language) is a declarative way to easily compose chains together.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 256, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "cc9aea69-5fce-46eb-9306-c8721c89e59c": {"__data__": {"id_": "cc9aea69-5fce-46eb-9306-c8721c89e59c", "embedding": null, "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/llamaindex_info.txt", "file_name": "llamaindex_info.txt", "file_type": "text/plain", "file_size": 242, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "8adf06f6-c61a-463d-b6e8-7a0683168715", "node_type": "4", "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/llamaindex_info.txt", "file_name": "llamaindex_info.txt", "file_type": "text/plain", "file_size": 242, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}, "hash": "5ec30849529887e2f34f344042327baa580bfdc7895dc958ab712a8aa470b277", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "LlamaIndex is a data framework for LLM applications to connect private datasets.\nIt enables loading data via SimpleDirectoryReader, parsing documents into Nodes, indexing them inside a VectorStoreIndex, and querying them using a Query Engine.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 242, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "6b5ffae4-9d72-4843-82c8-75270649a165": {"__data__": {"id_": "6b5ffae4-9d72-4843-82c8-75270649a165", "embedding": null, "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/student_faq.txt", "file_name": "student_faq.txt", "file_type": "text/plain", "file_size": 245, "creation_date": "2026-09-28", "last_modified_date": "2026-09-28"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "43964865-8b0c-4b1c-9bfa-f72fd678799b", "node_type": "4", "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/student_faq.txt", "file_name": "student_faq.txt", "file_type": "text/plain", "file_size": 245, "creation_date": "2026-09-28", "last_modified_date": "2026-09-28"}, "hash": "d3263207a4e73d953769e6cd086f264cb995cbe3eb8b7c048d77daca442497dd", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "FAQ 1: The PGDCA practical examination carries 40 marks and theory carries 60 marks.\nFAQ 2: Students must submit all unit lab notebooks before the final practical check.\nFAQ 3: The minimum passing grade for each unit practical evaluation is 50%.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 245, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "efef55cb-069b-42b7-bb89-4f1276c81993": {"__data__": {"id_": "efef55cb-069b-42b7-bb89-4f1276c81993", "embedding": null, "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/syllabus_pgdca.txt", "file_name": "syllabus_pgdca.txt", "file_type": "text/plain", "file_size": 418, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "7df538d7-e383-467f-ba49-ed65e02642e5", "node_type": "4", "metadata": {"file_path": "/Users/gvp/Desktop/github/Hands-On-LLM-PGDCA/unit-3/data/syllabus_pgdca.txt", "file_name": "syllabus_pgdca.txt", "file_type": "text/plain", "file_size": 418, "creation_date": "2026-07-14", "last_modified_date": "2026-07-14"}, "hash": "7693d5b6fc5dbebdddda76aa572b9161d71bc56dbcaa828bd31c1280435a0caf", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "PGDCA Course Structure and Units:\nUnit 1 covers Python ecosystem, environments, variables, data structures, and APIs.\nUnit 2 covers Advanced APIs, parameter tunings, concurrency, rate limits, and cost calculation models.\nUnit 3 covers LLM Frameworks, LangChain chains, memories, LlamaIndex documents search, and vector stores.\nUnit 4 covers local LLM runtimes, Ollama, model quantizations, and deploying final systems.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 418, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}}